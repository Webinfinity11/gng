{
  "name": "gng-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "prestart": "node scripts/db-migrate.mjs --if-configured",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test tests/public.spec.ts tests/visual.spec.ts",
    "test:hydration": "playwright test tests/hydration.spec.ts",
    "test:admin": "node scripts/test-admin.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-georgian": "5.3.0",
    "better-auth": "1.7.12",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
