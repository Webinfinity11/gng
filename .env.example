NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Neon connection string (pooled endpoint recommended), including sslmode=require.
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Cloudflare R2 S3 credentials scoped to this bucket. Server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket custom domain, e.g. https://media.example.com
R2_PUBLIC_URL=
# Configure only if your reverse proxy overwrites this header (e.g. x-real-ip).
TRUSTED_IP_HEADER=
# Contact form email (SMTP of the sending mailbox, info@gnginner.ge on liberty.hosthp.net). 465 = SSL, 587 = STARTTLS.
SMTP_HOST=liberty.hosthp.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional: sender address if different from SMTP_USER, and the inbox that receives the messages.
SMTP_FROM=
CONTACT_MAIL_TO=info@gnginner.ge
# Optional Cloudflare Turnstile (anti-bot check on the contact form). Both keys are needed to enable it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
