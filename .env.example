NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Neon connection string (pooled endpoint recommended), including sslmode=require.
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Cloudflare R2 S3 credentials scoped to this bucket. Server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket custom domain, e.g. https://media.example.com
R2_PUBLIC_URL=
# Configure only if your reverse proxy overwrites this header (e.g. x-real-ip).
TRUSTED_IP_HEADER=
